[Unit]
Description=Configure static IPv4 for radar Ethernet link
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
EnvironmentFile=/etc/indooruav/radar-static-ip.env
ExecStart=/bin/bash /opt/indooruav/scripts/configure_radar_static_ip.sh --eth-iface ${ETH_IFACE} --host-ip ${RADAR_HOST_IP} --prefix-len ${RADAR_PREFIX_LEN} --radar-ip ${RADAR_DEVICE_IP}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
